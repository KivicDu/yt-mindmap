# Gemini (required for AI mind map generation)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI key (reserved for the provider abstraction)
OPENAI_API_KEY=your_openai_key_here

# Comma-separated browser origins allowed to call the API
# (defaults to localhost:5173, 3000, 4173 and 8080)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Server config (used by your uvicorn command, not by main.py)
HOST=127.0.0.1
PORT=8001
