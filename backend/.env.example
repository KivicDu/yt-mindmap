# Gemini (required for AI mind map generation)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Thinking tokens for Gemini 2.5 models. 0 keeps real-time updates fast and
# cheap; raise it only if map quality matters more than latency.
GEMINI_THINKING_BUDGET=0
# Optional. Point the AI path at a mock or a proxy instead of the real API:
#   GEMINI_BASE_URL=http://127.0.0.1:9090
# Useful for tests, offline demos, or a gateway in front of Gemini. Leave it
# unset to use the SDK default.
# GEMINI_BASE_URL=

# Optional OpenAI key (reserved for the provider abstraction)
OPENAI_API_KEY=your_openai_key_here

# Comma-separated browser origins allowed to call the API
# (defaults to localhost:5173, 3000, 4173 and 8080)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------------------
# Database (required for accounts: register, login, dashboard)
# ---------------------------------------------------------------------------
# PostgreSQL 18 via psycopg 3. `postgresql://...` is rewritten by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://ytmindmap:ytmindmap@127.0.0.1:5432/ytmindmap
# Run `alembic upgrade head` once after creating the database.
DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Auth / session
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Email delivery (verification, password reset, email change)
# ---------------------------------------------------------------------------
# "log" writes messages to the backend log (development). "smtp" sends through
# the server below; Mailpit on 127.0.0.1:1025 is enough for local testing:
#   brew install mailpit && mailpit
# then set EMAIL_BACKEND=smtp, SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_STARTTLS=false (no auth needed by Mailpit).
EMAIL_BACKEND=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_FROM="yt-mindmap <no-reply@ytmindmap.local>"
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Set this to true locally to also return account links in the JSON response
# (the dashboard then shows a one-click shortcut). Never enable it on a public
# server: it bypasses the inbox and would leak password-reset links.
DEBUG_EMAIL_LINKS=false

# Refresh token cookie (HttpOnly) + readable "has a session" hint.
REFRESH_COOKIE_NAME=ytmm_refresh_token
SESSION_HINT_COOKIE_NAME=ytmm_session
# Set COOKIE_SECURE=true when the API is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Where the browser should land after login / on an OAuth error.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# OAuth (optional). Leave empty to keep the Google/GitHub buttons disabled.
# See docs/auth-oauth.md for the console steps and exact callback URLs.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL of this API. Register "<base>/api/auth/<provider>/callback".
OAUTH_CALLBACK_BASE=http://localhost:8001

# Server config (used by your uvicorn command, not by main.py)
HOST=127.0.0.1
PORT=8001

# ---------------------------------------------------------------------------
# Abuse protection (in-memory, so it matches the single-worker setup)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# POSTs to register/login/password/email endpoints, per IP per minute.
RATE_LIMIT_AUTH_PER_MINUTE=30
# /transcript and /update-map (the endpoints that call Gemini), per minute.
RATE_LIMIT_AI_PER_MINUTE=240
# Total AI calls per UTC day, per signed-in user and per anonymous IP.
AI_DAILY_QUOTA_PER_USER=5000
AI_DAILY_QUOTA_ANONYMOUS=1000
# Only enable behind a proxy that overwrites X-Forwarded-For; otherwise a
# client can spoof it and dodge the IP limits.
TRUST_PROXY_HEADERS=false
